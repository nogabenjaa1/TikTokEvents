# URL del backend (Express + Socket.IO). Necesaria solo cuando el frontend
# se despliega en un origen distinto al del backend (p. ej. frontend en
# Vercel, backend en Railway/Render/Fly). Dejar vacía/sin definir si el
# backend sigue sirviendo el build del frontend desde el mismo origen.
VITE_BACKEND_URL=https://tu-backend.up.railway.app

# MercadoPago está apagado: Stripe es el único medio de pago oficial. Con
# "true" vuelve a aparecer en Membresía (ver src/paymentProviders.js); sin
# esta variable no se muestra en ningún lado.
VITE_MERCADOPAGO_ENABLED=
# Public key de MercadoPago — la usa la pantalla de pago
# MercadoPagoCheckout.jsx (solo si VITE_MERCADOPAGO_ENABLED=true).
VITE_MP_PUBLIC_KEY=

# Publishable key de Stripe (dashboard.stripe.com -> Developers -> API
# keys) — la usan el formulario de Checkout de StripePaymentForm.jsx y la
# verificación de tarjeta de la prueba gratis (CardVerifyForm.jsx).
VITE_STRIPE_PUBLISHABLE_KEY=
