PORT=3001

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
KEY_HASH_SECRET=

# Uno o varios orígenes separados por coma (frontend en dev, y el dominio de
# Vercel en producción). Ej: https://tu-app.vercel.app,https://tudominio.com
CORS_ORIGIN=http://localhost:5173

# Connection string de Supabase: Project Settings -> Database -> Connection
# string -> Transaction pooler (puerto 6543) o Session pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# MercadoPago: panel de desarrolladores -> Tus integraciones -> credenciales.
# Access Token de PRUEBA mientras se integra; recién en producción se cambia
# por el de producción (nunca mezclar los dos).
MP_ACCESS_TOKEN=
# Clave secreta de firma del webhook (mismo panel, sección Webhooks) — se usa
# para validar el header x-signature en /api/payments/webhook.
MP_WEBHOOK_SECRET=

# Client ID / Client Secret: el código de esta integración NO los usa (son
# para el flujo OAuth "Mercado Pago Connect", pensado para plataformas que
# cobran en nombre de otros vendedores). Se dejan preparados por si algún
# día hacen falta; no es necesario llenarlos para que la app funcione.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# URL pública de ESTE backend (sin barra final) — MercadoPago la necesita
# para mandar la notificación del webhook. En Render es la misma URL del
# servicio (ej. https://tiktok-concurso.onrender.com).
BACKEND_URL=http://localhost:3001
# URL pública del frontend (sin barra final) — a dónde vuelve el streamer
# después de pagar (éxito/pendiente/error). En producción, el dominio de Vercel.
FRONTEND_URL=http://localhost:5173

# Spotify: developer.spotify.com/dashboard -> Create app. En "Redirect URIs"
# hay que agregar EXACTO: {BACKEND_URL}/api/spotify/callback (con el
# BACKEND_URL real de producción, no localhost, para que funcione en vivo).
# Sin esto configurado, "Conectar con Spotify" falla en el panel pero el
# resto de la plataforma sigue funcionando igual.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Alertas de regalos: dónde se guardan los archivos (imagen/gif/video/audio)
# que el streamer sube para cada regalo — MISMO proyecto de Supabase que ya
# usa DATABASE_URL de arriba. Sacar de: Project Settings -> API -> "Project
# URL" y "service_role" (secret, no la "anon" pública). Sin esto, el panel
# de Alertas falla al subir archivos pero el resto de la plataforma sigue
# funcionando igual.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
