PORT=3001

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
KEY_HASH_SECRET=

# Cifra access_token/refresh_token de Spotify en reposo (ver tokenCrypto.js)
# -- mismo comando de arriba para generarla. Si falta, las cuentas de
# Spotify YA conectadas siguen andando (quedan en texto plano hasta que
# refresquen), pero conectar una cuenta NUEVA o refrescar un token vencido
# falla con un error claro hasta que se configure. Tambien cifra el Client
# secret de la app de Spotify PROPIA que guarda cada streamer (sin la clave,
# guardarla falla).
TOKEN_ENCRYPTION_KEY=

# Uno o varios orígenes separados por coma (frontend en dev, y el dominio de
# Vercel en producción). Ej: https://tu-app.vercel.app,https://tudominio.com
CORS_ORIGIN=http://localhost:5173

# Connection string de Supabase: Project Settings -> Database -> Connection
# string -> Transaction pooler (puerto 6543) o Session pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# MercadoPago: panel de desarrolladores -> Tus integraciones -> credenciales.
# Access Token de PRUEBA mientras se integra; recién en producción se cambia
# por el de producción (nunca mezclar los dos).
MP_ACCESS_TOKEN=
# Clave secreta de firma del webhook (mismo panel, sección Webhooks) — se usa
# para validar el header x-signature en /api/payments/webhook.
MP_WEBHOOK_SECRET=

# Client ID / Client Secret: el código de esta integración NO los usa (son
# para el flujo OAuth "Mercado Pago Connect", pensado para plataformas que
# cobran en nombre de otros vendedores). Se dejan preparados por si algún
# día hacen falta; no es necesario llenarlos para que la app funcione.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Stripe: dashboard.stripe.com -> Developers -> API keys. La llave secreta
# ya indica sola si es de prueba (sk_test_...) o en vivo (sk_live_...), no
# hace falta un flag aparte como MP_TEST_MODE.
STRIPE_SECRET_KEY=
# Firma del webhook: dashboard.stripe.com -> Developers -> Webhooks -> tu
# endpoint (https://TU_BACKEND/api/payments/stripe/webhook, evento
# payment_intent.succeeded) -> "Signing secret".
STRIPE_WEBHOOK_SECRET=

# URL pública de ESTE backend (sin barra final) — MercadoPago la necesita
# para mandar la notificación del webhook. En Render es la misma URL del
# servicio (ej. https://tiktok-concurso.onrender.com).
BACKEND_URL=http://localhost:3001
# URL pública del frontend (sin barra final) — a dónde vuelve el streamer
# después de pagar (éxito/pendiente/error). En producción, el dominio de Vercel.
FRONTEND_URL=http://localhost:5173

# Spotify: developer.spotify.com/dashboard -> Create app. En "Redirect URIs"
# hay que agregar EXACTO: {BACKEND_URL}/api/spotify/callback (con el
# BACKEND_URL real de producción, no localhost, para que funcione en vivo).
# Sin esto configurado, "Conectar con Spotify" falla en el panel pero el
# resto de la plataforma sigue funcionando igual.
# Esta es la app de la PLATAFORMA: en modo Development solo admite 5
# usuarios, asi que la usan la licencia admin y los 5 primeros Lifetime (cada
# cuenta de Spotify se carga a mano en Settings > User Management; dos
# licencias pueden compartir una misma cuenta y cuenta como un solo usuario).
# El resto conecta con su PROPIA app, que crea cada streamer siguiendo la
# guia del panel (ver spotify.js, "Quien puede usarlo").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Alertas de regalos: dónde se guardan los archivos (imagen/gif/video/audio)
# que el streamer sube para cada regalo — MISMO proyecto de Supabase que ya
# usa DATABASE_URL de arriba. Sacar de: Project Settings -> API -> "Project
# URL" y "service_role" (secret, no la "anon" pública). Sin esto, el panel
# de Alertas falla al subir archivos pero el resto de la plataforma sigue
# funcionando igual.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Downloader (YouTube / TikTok): proxy que se usa SOLO para los enlaces de
# TikTok (sin él TikTok bloquea al servidor). Formato:
# http://usuario:contrasena@host:puerto . No se muestra nunca en pantalla.
YTDL_PROXY=
# Opcional: más sitios permitidos además de YouTube y TikTok, separados por
# coma (dominios, por ejemplo: instagram.com,x.com). Por defecto, ninguno.
DOWNLOADER_EXTRA_HOSTS=
# Opcional: tamaño máximo de un archivo descargado (número y K, M o G).
# Por defecto 1G.
DOWNLOADER_MAX_FILESIZE=1G

# Overlays de OBS: los enlaces nuevos llevan un token de solo lectura, pero los
# enlaces anteriores (que llevan la clave de licencia) siguen funcionando. Cuando
# ya nadie los use, "off" los apaga y cierra esa puerta por completo.
OVERLAY_LEGACY_KEYS=on

# Tope de conexiones de socket NUEVAS por IP y por minuto (frena a quien intente
# inundar el servidor con claves falsas). Un panel u overlay normal abre una sola.
SOCKET_HANDSHAKES_PER_MINUTE=300
